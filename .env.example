# Supabase project URL — Project Settings → API / Connect dialog
NEXT_PUBLIC_SUPABASE_URL=

# Prefer the new publishable key (sb_publishable_...).
# Legacy anon JWT key still works as a fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security entirely - never prefix with
# NEXT_PUBLIC_, never import from a Client Component, and never log it.
# Used only by the payment webhook route to call confirm_booking_payment.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe secret key (sk_test_/sk_live_). Server-only - never prefix with
# NEXT_PUBLIC_. Used to create PaymentIntents and to verify webhooks.
STRIPE_SECRET_KEY=

# Stripe publishable key (pk_test_/pk_live_). Safe to expose to the browser -
# required by the embedded `<Elements>`/`<PaymentElement>` PromptPay + card flow.
# Dashboard → Developers → API keys. Must not be empty or payment UI will not load.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Signing secret for the payment webhook endpoint (whsec_...), from
# Stripe Dashboard -> Developers -> Webhooks -> your endpoint, or
# `stripe listen --print-secret` when testing locally with the Stripe CLI.
STRIPE_WEBHOOK_SECRET=
