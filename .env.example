# Supabase project URL — Project Settings → API / Connect dialog
NEXT_PUBLIC_SUPABASE_URL=

# Prefer the new publishable key (sb_publishable_...).
# Legacy anon JWT key still works as a fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security entirely - never prefix with
# NEXT_PUBLIC_, never import from a Client Component, and never log it.
# Used only by the payment webhook route to call confirm_booking_payment.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe secret key (sk_test_/sk_live_). Server-only - never prefix with
# NEXT_PUBLIC_. Used to create PaymentIntents and to verify webhooks.
STRIPE_SECRET_KEY=

# Stripe publishable key (pk_test_/pk_live_). Safe to expose to the browser -
# required by the embedded `<Elements>`/`<PaymentElement>` PromptPay + card flow.
# Dashboard → Developers → API keys. Must not be empty or payment UI will not load.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Signing secret for the payment webhook endpoint (whsec_...).
#
# LOCAL:  `stripe listen --forward-to localhost:3000/api/webhook/payment`
#         then paste the CLI-printed whsec_... here.
#
# VERCEL/PRODUCTION: stripe listen does NOT reach Vercel. Create an endpoint
#   in Stripe Dashboard → Developers → Webhooks:
#     URL:  https://<your-domain>/api/webhook/payment
#     events: payment_intent.succeeded (at minimum)
#   then put THAT endpoint's signing secret in Vercel env as STRIPE_WEBHOOK_SECRET.
#   Do not reuse the local CLI secret on Vercel - signature verification will fail
#   and bookings will stay `pending` after a successful charge.
#
# The app also confirms bookings from the payment page after Stripe reports
# success (finalizePaidBookings), so a missing webhook is less catastrophic,
# but the Dashboard webhook is still required when the guest closes the tab
# before the browser finalize call finishes.
STRIPE_WEBHOOK_SECRET=

# Resend API key (re_...). Server-only - never prefix with NEXT_PUBLIC_.
# Used by the payment webhook to send the confirmed booking E-Ticket email.
# Dashboard → API Keys → Create API Key.
RESEND_API_KEY=

# Optional. Verified sender for E-Tickets. Defaults to Resend's onboarding
# address (test-only). For production, verify a domain in Resend and set e.g.
#   Tennis Club <bookings@yourdomain.com>
# RESEND_FROM_EMAIL=
